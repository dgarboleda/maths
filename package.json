{
  "name": "maths",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/liberar-puerto-dev.mjs && node -e \"require('fs').rmSync('.next/dev/cache/turbopack', { recursive: true, force: true })\"",
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:minijuegos": "playwright test e2e/aprendizaje-minijuegos.spec.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "emuladores": "node scripts/emuladores.mjs",
    "perf": "node scripts/perf.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "upload": "npm run build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "audit:security": "node scripts/security-audit.mjs",
    "functions:build": "npm --prefix functions run build",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "deploy:all": "npm run deploy",
    "deploy:frontend": "npm run build && opennextjs-cloudflare deploy",
    "analisis:items": "node scripts/analisis-items.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.41.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.28.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
