{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "maths",
	"compatibility_date": "2026-08-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, el nombre del servicio debe coincidir con el del worker
			// ver https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "maths"
		}
	],
	"images": {
		// Habilita la optimización de imágenes
		// ver https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Logs del Worker en el dashboard de Cloudflare (útil para depurar cosas
	// como el auth/invalid-api-key: ahí se ve exactamente qué variables de
	// entorno tenía el Worker en tiempo de ejecución). Aquí en vez de solo en
	// el dashboard para que un `wrangler deploy` no lo desactive sin querer y
	// quede igual en cualquier máquina que despliegue.
	// ver https://developers.cloudflare.com/workers/observability/logs/workers-logs/
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
	/*
	 * Sin caché con R2: crear el bucket requiere estar autenticado con
	 * `wrangler login`, algo que este entorno no puede hacer. Para activarla,
	 * ejecuta `wrangler r2 bucket create maths-opennext-cache` y añade aquí
	 * "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "maths-opennext-cache" }],
	 * más el incrementalCache en open-next.config.ts.
	 * Ver https://opennext.js.org/cloudflare/caching
	 */
}
