rules_version = '2';

// Modelo: /parents/{parentId} es el padre autenticado (parentId == auth.uid).
// Todo lo del hogar cuelga debajo: children/{childId}, y dentro de cada hijo
// sus colecciones de progreso, intentos, estrellas y canjes.
//
// El niño también puede tener su PROPIA sesión, sin la del padre en el mismo
// dispositivo: `verifyChildPin` (Cloud Function, functions/src/index.ts)
// valida el PIN contra Firestore con el Admin SDK (que no pasa por estas
// reglas) y emite un custom token con claims { role: "child", parentId,
// childId } — nunca un uid real de Firebase Auth. `isChild`/`isAnyChildOf`
// leen esos claims. Un hijo nunca puede ELEGIR sus propios claims: los pone
// la función, con el PIN ya verificado del lado del servidor.
service cloud.firestore {
  match /databases/{database}/documents {

    function isParent(parentId) {
      return request.auth != null && request.auth.uid == parentId;
    }

    // Cualquier hijo autenticado de ESTA familia (para leer contenido
    // compartido entre hermanos: niveles, mundo, currícula). `.get(key,
    // default)` (no acceso con punto): un token de padre normal no tiene
    // NINGUNA de estas claims — ni siquiera en `false` — y leer una clave
    // ausente con `.role`/`.parentId` hace que el motor de reglas tire una
    // excepción de evaluación en vez de devolver `null` (verificado con el
    // emulador: sin este cambio, cualquier lectura denegada de un padre
    // — donde `isParent` da `false` y por eso SÍ se llega a evaluar esto —
    // mostraba "Property role is undefined on object" en vez de un simple
    // permiso denegado).
    function isAnyChildOf(parentId) {
      return request.auth != null
        && request.auth.token.get('role', null) == 'child'
        && request.auth.token.get('parentId', null) == parentId;
    }

    // Ese hijo puntual (para sus propios datos de progreso).
    function isChild(parentId, childId) {
      return isAnyChildOf(parentId) && request.auth.token.get('childId', null) == childId
        && exists(/databases/$(database)/documents/parents/$(parentId)/children/$(childId))
        && get(/databases/$(database)/documents/parents/$(parentId)/children/$(childId)).data.get('deleting', false) != true;
    }

    function isParentOrChild(parentId, childId) {
      return isParent(parentId) || isChild(parentId, childId);
    }

    function validAttempt(data) {
      return data.keys().hasAll(['skillId', 'itemId', 'correct', 'createdAt'])
        && data.keys().hasOnly(['skillId', 'itemId', 'correct', 'createdAt', 'hintsUsed'])
        && data.skillId is string && data.skillId.size() > 0 && data.skillId.size() <= 160
        && data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 64
        && data.correct is bool
        && data.createdAt == request.time
        && (!('hintsUsed' in data) || (data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 50));
    }

    match /parents/{parentId} {
      // El documento del padre no lo lee ningún hijo — nada bajo /jugar/**
      // lo necesita.
      allow read, write: if isParent(parentId);

      match /children/{childId} {
        allow read: if isParentOrChild(parentId, childId);
        // El hash del PIN es un HMAC con un secreto de Functions
        // (`setChildPin`): ningún navegador, ni el de la familia, lo escribe.
        allow create: if isParent(parentId)
          && !request.resource.data.keys().hasAny(['pinHash', 'pinHashVersion']);
        allow delete: if isParent(parentId);
        // El hijo solo puede tocar su propio documento para su propio
        // progreso de juego — nunca su nombre, PIN, ni nada que el padre
        // administre. Campos permitidos: `placementStatus` (evaluación
        // diagnóstica, evaluacion/page.tsx), `avatarId` (elegir avatar,
        // Fase 32, AvatarPickerDialog.tsx), `seenStoryIds` (historia ya
        // vista, Fase 30, mapa/page.tsx) y `streakDays`/`lastPlayedDay`
        // (racha de días jugados, Fase 35, src/lib/streak.ts).
        allow update: if (isParent(parentId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinHash', 'pinHashVersion']))
          || (isChild(parentId, childId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['placementStatus', 'avatarId', 'seenStoryIds', 'streakDays', 'lastPlayedDay']));

        match /skillsProgress/{skillId} {
          allow read, write: if isParentOrChild(parentId, childId);
        }

        // La evidencia educativa y sus agregados los valida Functions.
        // El dispositivo solo lee su propio avance; la familia puede borrarlo.
        match /learningProgress/{lessonId} {
          allow read: if isParentOrChild(parentId, childId);
          allow delete: if isParent(parentId);
          allow create, update: if false;
        }
        match /learningMissions/{missionId} {
          allow read: if isParentOrChild(parentId, childId);
          allow delete: if isParent(parentId);
          allow create, update: if false;
        }
        match /learningEvidence/{eventId} {
          allow read: if isParentOrChild(parentId, childId);
          allow delete: if isParent(parentId);
          allow create, update: if false;
        }

        // Bitácora de intentos: se agrega, nunca se corrige ni se borra
        // desde el dispositivo del hijo. Lo que escribe la sesión infantil se
        // valida porque alimenta la analítica del editor y del panel: campos
        // conocidos, tipos y hora del servidor (sin fechar intentos a mano).
        // El acierto lo decide aún el navegador en los módulos anteriores;
        // la evidencia nueva vive en learningEvidence.
        match /attempts/{attemptId} {
          allow read: if isParentOrChild(parentId, childId);
          allow create: if isParent(parentId)
            || (isChild(parentId, childId) && validAttempt(request.resource.data));
          allow update, delete: if isParent(parentId);
        }

        // Libro mayor: el hijo lo lee y nunca lo escribe. Los premios y
        // canjes pasan por Functions, que escribe movimiento+saldo en una
        // transacción. La familia conserva escritura directa (corrección
        // manual, borrado del perfil, migración de datos antiguos): si
        // desalinea el agregado, `initializeStarBalance` con `reconcile`
        // lo recalcula desde el libro mayor.
        match /starLedger/{entryId} {
          allow read: if isParentOrChild(parentId, childId);
          allow create: if isParent(parentId);
          allow update, delete: if isParent(parentId);
        }

        // Functions confirma el saldo junto con el movimiento correspondiente.
        match /starBalance/{docId} {
          allow read: if isParentOrChild(parentId, childId);
          allow write: if isParent(parentId);
        }

        // El hijo pide un canje; solo el padre lo aprueba/rechaza/borra.
        match /redemptionRequests/{requestId} {
          allow read, create: if isParentOrChild(parentId, childId);
          allow update, delete: if isParent(parentId);
        }

        // La evaluación diagnóstica la rinde el propio hijo; el resultado ya
        // guardado no se corrige a mano.
        match /placements/{placementId} {
          allow read, create: if isParentOrChild(parentId, childId);
          allow update, delete: if isParent(parentId);
        }

        // Insignias: se otorgan solas durante el juego, igual que
        // skillsProgress.
        match /badges/{badgeId} {
          allow read, write: if isParentOrChild(parentId, childId);
        }

        // Marcas personales (Fase 35, docs/plan-jugabilidad.md §9,
        // src/lib/records.ts): mismo dueño y mismo criterio que
        // skillsProgress — el hijo las lee y las actualiza solo mientras
        // juega, sin corrección manual.
        match /records/{recordId} {
          allow read, write: if isParentOrChild(parentId, childId);
        }
      }

      // Niveles del Level Editor (docs/level-editor-plan.md §10.2): propiedad
      // del padre-autor, no de un hijo — cualquier hijo de la familia puede
      // jugarlos (lectura), igual que /curriculum es del catálogo, no de un
      // hijo. Autoría (escritura) sigue siendo solo del padre.
      match /levels/{levelId} {
        allow read: if isParent(parentId) || isAnyChildOf(parentId);
        allow write: if isParent(parentId);

        // Cada guardado deja un snapshot inmutable — nunca se pisa ni se
        // borra una versión ya escrita (versionado optimista, §10.4).
        match /versions/{versionId} {
          allow read: if isParent(parentId) || isAnyChildOf(parentId);
          allow create: if isParent(parentId);
          allow update, delete: if false;
        }
      }

      // Metadata de las imágenes subidas por el padre-autor
      // (docs/asset-management-plan.md §C.2). El archivo vive en Storage
      // (storage.rules); acá solo su ficha: etiqueta, tipo, dimensiones.
      match /levelAssets/{assetId} {
        allow read: if isParent(parentId) || isAnyChildOf(parentId);
        allow write: if isParent(parentId);
      }

      // Mundo del juego: historia, capítulos, grafo de niveles, reglas
      // generales y catálogo de avatares (docs/level-editor-plan-v2.md §3).
      // Mismo dueño y mismo versionado inmutable que /levels.
      match /world/{worldId} {
        allow read: if isParent(parentId) || isAnyChildOf(parentId);
        allow write: if isParent(parentId);
        match /versions/{versionId} {
          allow read: if isParent(parentId) || isAnyChildOf(parentId);
          allow create: if isParent(parentId);
          allow update, delete: if false;
        }
      }

      // Currícula personalizada del padre-autor (docs/level-editor-plan-v2.md
      // §7.3): módulos con el mismo contrato que los de código (id, hilo,
      // dificultad, prerrequisitos, generador, concepto, ejemplos). Sin
      // subcolección de versiones — un módulo es mucho más chico que un
      // nivel y no justifica ese costo. Un hijo la lee para poder jugar
      // (useCustomCurriculum se hidrata también en /jugar/{childId}/**);
      // solo el padre la edita.
      match /curriculumModules/{moduleId} {
        allow read: if isParent(parentId) || isAnyChildOf(parentId);
        allow write: if isParent(parentId);
      }
    }

    // Contenido curricular: catálogo compartido de hilos/unidades, de solo
    // lectura para cualquier usuario autenticado (padre o hijo); se
    // administra aparte (consola o script de siembra), nunca desde el
    // cliente del juego.
    match /curriculum/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
